# Configuration file for agent-cli-orchestrator

# Repository configuration
repositories:
  - name: "agent-cli-orchestrator"
    path: "."
    default: true
  - name: "lioncubs"
    path: "/workspaces/lioncubs"
  
# Server configuration
server:
  host: "0.0.0.0"
  port: 8000
  
# Copilot CLI configuration
copilot:
  enabled: true
  timeout: 300  # seconds
  log_dir: "./logs/copilot"  # CLI log directory (files created by Copilot CLI)
  
# Worktree configuration
worktrees:
  base_path: "../agent-cli-orchestrator.worktrees"
