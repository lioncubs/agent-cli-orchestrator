%% Golden Rule Isolation
%% Visualizes the branch and worktree isolation enforced by the Golden Rule

flowchart TB
    subgraph mainRepo[Main Repository]
        direction TB
        M1[main branch<br/>Protected]:::success
        M2[feature branches]:::info
        M3[.git directory]:::darkGray
    end
    
    subgraph goldenRule[⚠️ GOLDEN RULE BOUNDARY ⚠️]
        direction TB
        
        subgraph isolation[Isolation Layer]
            direction LR
            I1[No direct<br/>modifications]:::warning
            I2[All changes via<br/>worktree]:::warning
            I3[All merges via<br/>Pull Request]:::warning
        end
        
        subgraph delegations[Active Delegations]
            direction TB
            
            subgraph del1[Delegation 1]
                direction TB
                D1B[Branch:<br/>agent/user1/abc-feature]:::primaryOrange
                D1W[Worktree:<br/>./worktrees/user1-abc]:::lightOrange
                D1C[Changes committed<br/>locally]:::lightGreen
            end
            
            subgraph del2[Delegation 2]
                direction TB
                D2B[Branch:<br/>agent/user2/xyz-bugfix]:::primaryOrange
                D2W[Worktree:<br/>./worktrees/user2-xyz]:::lightOrange
                D2C[Changes committed<br/>locally]:::lightGreen
            end
        end
        
        subgraph research[Research Sessions]
            direction TB
            R1[Temp Worktree<br/>Detached HEAD]:::lightPurple
            R2[Read-only access<br/>to repository]:::lightBlue
            R3[Artifacts saved<br/>No commits]:::lightGreen
        end
    end
    
    subgraph prProcess[Pull Request Process]
        direction TB
        PR1[Create PR from<br/>delegation branch]:::primaryBlue
        PR2[Human Code Review<br/>REQUIRED]:::warning
        PR3[Automated Tests<br/>Optional]:::info
        PR4[Merge to main<br/>branch]:::success
    end
    
    %% Connections
    M1 -.->|base for delegations| del1
    M1 -.->|base for delegations| del2
    M1 -.->|base for research| research
    
    D1B --> D1W
    D1W --> D1C
    D2B --> D2W
    D2W --> D2C
    
    D1C -->|push branch| PR1
    D2C -->|push branch| PR1
    
    PR1 --> PR2
    PR2 --> PR3
    PR3 --> PR4
    PR4 -->|merge| M1
    
    %% Barriers
    isolation -.->|enforces| delegations
    isolation -.->|enforces| research
    
    %% Style definitions
    classDef primaryBlue fill:#2563eb,stroke:#1e40af,color:#ffffff,stroke-width:2px
    classDef primaryOrange fill:#ea580c,stroke:#c2410c,color:#ffffff,stroke-width:2px
    classDef lightBlue fill:#dbeafe,stroke:#2563eb,color:#1e40af,stroke-width:2px
    classDef lightOrange fill:#ffedd5,stroke:#ea580c,color:#c2410c,stroke-width:2px
    classDef lightGreen fill:#dcfce7,stroke:#16a34a,color:#15803d,stroke-width:2px
    classDef lightPurple fill:#f3e8ff,stroke:#9333ea,color:#7e22ce,stroke-width:2px
    classDef success fill:#22c55e,stroke:#15803d,color:#ffffff,stroke-width:2px
    classDef warning fill:#eab308,stroke:#ca8a04,color:#ffffff,stroke-width:2px
    classDef info fill:#3b82f6,stroke:#2563eb,color:#ffffff,stroke-width:2px
    classDef darkGray fill:#1f2937,stroke:#111827,color:#ffffff,stroke-width:2px
    
    %% Subgraph styles
    style mainRepo fill:#f0fdf4,stroke:#16a34a,stroke-width:4px
    style goldenRule fill:#fef3c7,stroke:#ea580c,stroke-width:4px,stroke-dasharray: 5 5
    style isolation fill:#fef2f2,stroke:#ef4444,stroke-width:3px
    style delegations fill:#fff7ed,stroke:#ea580c,stroke-width:2px
    style del1 fill:#ffedd5,stroke:#ea580c,stroke-width:2px
    style del2 fill:#ffedd5,stroke:#ea580c,stroke-width:2px
    style research fill:#faf5ff,stroke:#9333ea,stroke-width:2px
    style prProcess fill:#eff6ff,stroke:#2563eb,stroke-width:3px
